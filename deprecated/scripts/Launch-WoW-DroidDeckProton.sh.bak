#!/bin/bash
# DroidDeck helper: run a native ARM64 WoW client under DroidDeck-Proton with
# the two Wine ARM64 fixes applied (libsigctx_zero.so + TEB-table ntdll stubs).
# Steam runs this as a Linux target; the script calls the Proton wrap itself.
#
# DroidDeck's component manager already places an ARM64 DXVK in Proton's
# lib/wine/dxvk, which Proton loads as builtin. Never put d3d11/dxgi in
# WINEDLLOVERRIDES — the client's anti-tamper check rejects that.
set -uo pipefail

APPID="${SteamAppId:-2980947332}"
if [[ "$APPID" == "0" || ${#APPID} -gt 10 ]]; then APPID=2980947332; fi
STEAM_ROOT="${STEAM_COMPAT_CLIENT_INSTALL_PATH:-/root/.local/share/Steam}"
# One container for launcher and game: the install lives inside the Battle.net
# shortcut's prefix (Agent only updates/launches an install on C:), so the direct
# launcher uses that prefix too instead of Steam's per-shortcut one.
BNET_APPID="${BNET_APPID:-4153382437}"
PREFIX="${WOW_PREFIX:-$STEAM_ROOT/steamapps/compatdata/$BNET_APPID}"
TOOL="${WOW_PROTON_DIR:-$STEAM_ROOT/compatibilitytools.d/DroidDeck-Proton 11-9.1}"
PROTON="$TOOL/droiddeck-proton-wrap"
NTDLL_SRC="$TOOL/files/lib/wine/aarch64-windows/ntdll.dll"
SHIM="${WOW_SIGSHIM:-/usr/local/lib/libsigctx_zero.so}"
# <KeServiceDescriptorTable>:<__wine_syscall_dispatcher> offsets in this
# Proton's aarch64-unix/ntdll.so (unstripped: nm ntdll.so | grep ...).
TEBSTUB_OFFSETS="${WOW_TEBSTUB_OFFSETS:-b0a68:43240}"
WOW_ROOT="${WOW_ROOT:-$PREFIX/pfx/drive_c/Program Files (x86)/World of Warcraft}"
WOW="$WOW_ROOT/_classic_beta_"
EXE="$WOW/WowB-ARM64.exe"
ICD="${WOW_ICD:-/data/user/0/com.droiddeck.launcher/files/linux_vulkan_drivers/Mesa_Turnip_v27.0.0-20261018-r3-A8xx-Linux/icd.json}"
LOGDIR="${WOW_LOGDIR:-/tmp/wow-launch}"
LOG="$LOGDIR/proton-launch.log"
WINELOG="$LOGDIR/proton-wine.log"

mkdir -p "$LOGDIR"
exec >>"$LOG" 2>&1
echo "======== $(date -Iseconds) pid=$$ ========"
echo "appid=$APPID prefix=$PREFIX tool=$TOOL"

for f in "$PROTON" "$SHIM" "$EXE" "$ICD" "$NTDLL_SRC"; do
  if [[ ! -e "$f" ]]; then echo "Launch-WoW-DroidDeckProton: missing $f"; exit 1; fi
done

export STEAM_COMPAT_CLIENT_INSTALL_PATH="$STEAM_ROOT"
export STEAM_COMPAT_DATA_PATH="$PREFIX"
export SteamAppId="$APPID"
export SteamGameId="${SteamGameId:-$APPID}"
export VK_ICD_FILENAMES="$ICD"
export VK_DRIVER_FILES="$ICD"
export WINEESYNC="${WOW_WINEESYNC:-1}"
unset PROTON_NO_ESYNC
export LANG="${WOW_LANG:-en_US.UTF-8}"
export LC_ALL="${WOW_LC_ALL:-en_US.UTF-8}"
export WINEDEBUG="${WOW_WINEDEBUG:-+loaddll,+err,+msgbox}"
export DXVK_LOG_LEVEL="${WOW_DXVK_LOG_LEVEL:-info}"
export DXVK_LOG_PATH="C:\\dxvk-logs"
# gamescope already presents at 60; cap DXVK there and leave client vsync off.
export DXVK_FRAME_RATE="${WOW_DXVK_FRAME_RATE:-60}"
mkdir -p "$PREFIX/pfx/drive_c/dxvk-logs"
export WINE_TEBSTUB_OFFSETS="$TEBSTUB_OFFSETS"

pre="${LD_PRELOAD:-}"
pre="${pre//\/root\/.steam\/bin32\/gameoverlayrenderer.so/}"
pre="${pre##:}"; pre="${pre%%:}"
export LD_PRELOAD="${pre:+$pre:}$SHIM"
echo "LD_PRELOAD=$LD_PRELOAD WINE_TEBSTUB_OFFSETS=$WINE_TEBSTUB_OFFSETS"

for p in $(pgrep -x WowB-ARM64.exe 2>/dev/null); do
  echo "killing stale WowB pid $p"; kill -9 "$p"
done

# The client maps C:\windows\system32\ntdll.dll from disk; it must carry the
# TEB-table stubs too.  Proton keeps a full copy in the prefix, so sync it.
SYS32="$PREFIX/pfx/drive_c/windows/system32"
if [[ -f "$SYS32/ntdll.dll" ]] && ! cmp -s "$NTDLL_SRC" "$SYS32/ntdll.dll"; then
  cp -f "$NTDLL_SRC" "$SYS32/ntdll.dll.bl-new" && mv -f "$SYS32/ntdll.dll.bl-new" "$SYS32/ntdll.dll"
  echo "synced patched ntdll.dll into prefix"
fi

PORTAL="${WOW_PORTAL:-test}"
CFG="$WOW/WTF/Config.wtf"
mkdir -p "$WOW/WTF"
set_cvar() {
  local key="$1" val="$2"
  if ! grep -q "^SET $key \"$val\"" "$CFG" 2>/dev/null; then
    sed -i "/^SET $key /d" "$CFG" 2>/dev/null
    echo "SET $key \"$val\"" >>"$CFG"
    echo "cvar $key=$val"
  fi
}
set_cvar portal "$PORTAL"
# 1060x480 is the same 2.21:1 as the 1590x720 session (1.5x scale, larger UI).
set_cvar vsync 0
set_cvar gxWindow "1"
set_cvar gxWindowedResolution "${WOW_RES:-1060x480}"
set_cvar gxResolution "${WOW_RES:-1060x480}"
# Maximize fills the 1590x720 session and ignores the lower 3D res.
set_cvar GxMaximize 0
set_cvar farclip "${WOW_FARCLIP:-800}"
set_cvar shadowMode 0
set_cvar reflectionMode 0
set_cvar particleDensity 0
set_cvar particleMTDensity 0
# Grass/flowers: cheap compared to shadows. Quality 1 defaults this to 0.
set_cvar graphicsGroundClutter 3
set_cvar groundEffectDensity 80
set_cvar groundEffectDist 80

# Gamescope focuses only windows carrying STEAM_GAME; the Steam overlay does not
# stamp Proton's windows here, so do it ourselves (see droiddeck-steamgame-stamp.sh).
STAMPER="${WOW_STAMPER:-/usr/local/bin/droiddeck-steamgame-stamp.sh}"
if [[ -x "$STAMPER" ]]; then
  "$STAMPER" "$APPID" $$ "${DISPLAY:-:1}" >>"$LOGDIR/stamper.log" 2>&1 &
  echo "stamper pid $!"
fi

cd "$WOW" || exit 1
echo "exec proton waitforexitandrun $EXE -d3d11 (wine-log $WINELOG)"
: >"$WINELOG"
"$PROTON" waitforexitandrun "$EXE" -d3d11 >>"$WINELOG" 2>&1
rc=$?
echo "proton-exit $rc"
tail -n 12 "$WOW/Logs/gx.log" 2>/dev/null || true
exit "$rc"
